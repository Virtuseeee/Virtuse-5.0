RewriteRule ^hu/(?:gold(?:/.*)?|silver(?:/.*)?|platinum(?:/.*)?|commodities(?:/.*)?|crypto-commodities-what-are-they(?:/.*)?|pax-gold-prospectus(?:/.*)?|etfs(?:/.*)?|oil(?:/.*)?|crude-oil(?:/.*)?)$ https://virtuse.com/hu/asset-returns.html [R=301,L]
RewriteRule ^cs/(?:gold(?:/.*)?|silver(?:/.*)?|platinum(?:/.*)?|commodities(?:/.*)?|crypto-commodities-what-are-they(?:/.*)?|pax-gold-prospectus(?:/.*)?|etfs(?:/.*)?|oil(?:/.*)?|crude-oil(?:/.*)?)$ https://virtuse.com/cs/asset-returns.html [R=301,L]
RewriteRule ^sk/(?:gold(?:/.*)?|silver(?:/.*)?|platinum(?:/.*)?|commodities(?:/.*)?|crypto-commodities-what-are-they(?:/.*)?|zlato(?:/.*)?|striebro(?:/.*)?|platina(?:/.*)?|komodity(?:/.*)?|pax-gold-prospectus(?:/.*)?|etfs(?:/.*)?|oil(?:/.*)?|crude-oil(?:/.*)?|ropa(?:/.*)?)$ https://virtuse.com/sk/asset-returns.html [R=301,L]
RewriteRule ^uk/(?:gold(?:/.*)?|silver(?:/.*)?|platinum(?:/.*)?|commodities(?:/.*)?|crypto-commodities-what-are-they(?:/.*)?|pax-gold-prospectus(?:/.*)?|etfs(?:/.*)?|oil(?:/.*)?|crude-oil(?:/.*)?)$ https://virtuse.com/uk/asset-returns.html [R=301,L]
RewriteRule ^ru/(?:gold(?:/.*)?|silver(?:/.*)?|platinum(?:/.*)?|commodities(?:/.*)?|crypto-commodities-what-are-they(?:/.*)?|pax-gold-prospectus(?:/.*)?|etfs(?:/.*)?|oil(?:/.*)?|crude-oil(?:/.*)?)$ https://virtuse.com/ru/asset-returns.html [R=301,L]
RewriteRule ^it/(?:gold(?:/.*)?|silver(?:/.*)?|platinum(?:/.*)?|commodities(?:/.*)?|crypto-commodities-what-are-they(?:/.*)?|pax-gold-prospectus(?:/.*)?|etfs(?:/.*)?|oil(?:/.*)?|crude-oil(?:/.*)?)$ https://virtuse.com/asset-returns.html [R=301,L]
RewriteRule ^(?:virtusex-platform(?:/.*)?|token-listing(?:/.*)?|virtu-token(?:/.*)?|delisting-announcement(?:/.*)?|hummingbot-integration(?:/.*)?)$ https://virtuse.com/concierge.html [R=301,L]
RewriteRule ^de/(?:virtusex-platform(?:/.*)?|token-listing(?:/.*)?|virtu-token(?:/.*)?|delisting-announcement(?:/.*)?|hummingbot-integration(?:/.*)?)$ https://virtuse.com/de/concierge.html [R=301,L]
