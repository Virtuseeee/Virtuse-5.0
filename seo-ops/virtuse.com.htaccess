# Virtuse — static site (virtuse.com). The WordPress blog lives on blog.virtuse.com.
#
# Until 13 Oct 2026 every unknown path was 301'd to the same path on blog.virtuse.com,
# where most of them 404'd. Now old URLs are mapped explicitly (approved-redirects block,
# legacy-exchange block) and anything else gets this site's own 404 page (status 404).

RewriteEngine On

# Canonical host: https://virtuse.com (one 301 hop for http, www and http+www).
# Runs first so it applies to real files too, not just the fallback below.
# nginx sits in front of Apache here: a request counts as https if Apache
# sees HTTPS=on OR the proxy sends X-Forwarded-Proto: https. If the proxy
# does neither, https://virtuse.com/ would redirect to itself: check it right
# after the upload and restore virtuse.com.htaccess.before if it loops.
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://virtuse.com/$1 [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://virtuse.com/$1 [R=301,L]

# No Slovak Brief page exists (the Brief is EN-only): old /sk/news.html hits go to /news.html
RewriteRule ^sk/news\.html$ https://virtuse.com/news.html [R=301,L]

# Brief articles. The static page /stories/<slug>/ (sk/stories/) is the canonical copy.
# Short links /a/<slug> and the old reader URL article.html?slug=<slug>[&lang=sk] 301 there
# when the page exists; a story published after the last build goes to the reader (302).
RewriteCond %{DOCUMENT_ROOT}/stories/$1/index.html -f
RewriteRule ^a/([a-z0-9-]+)/?$ https://virtuse.com/stories/$1/ [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/sk/stories/$1/index.html -f
RewriteRule ^sk/a/([a-z0-9-]+)/?$ https://virtuse.com/sk/stories/$1/ [R=301,L]
RewriteRule ^a/([a-z0-9-]+)/?$ https://virtuse.com/article.html?slug=$1 [R=302,L]
RewriteRule ^sk/a/([a-z0-9-]+)/?$ https://virtuse.com/article.html?slug=$1&lang=sk [R=302,L]
# article.html?slug=… rules: see the approved-redirects block below.

# BEGIN approved-redirects-2026-10-13
# Approved by Ras 13 Oct 2026 (HANDOVER-claude-seo-redirects.md): one 301 hop to a 200 page.
# GENERATED by seo-ops/build_redirects.py from seo-ops/redirects-2026-10-13.csv,
# seo-ops/wp-posts-inventory.csv and the site folder. Edit those and re-run; do not edit here.
# Held rows (wait for Ras):
#   /bots.html → /concierge.html: Ras 13 Oct 2026: keep live, no redirect. table row 3 says bots.html (+lang) but bots.html is a live 200 category page in the nav of ~270 pages and in sitemap.xml
#   /blog-sk.html → /blog.html: Ras 13 Oct 2026: keep live, no redirect. table row 9 lists /blog-sk.html, but it is the live Slovak blog hub (200, in sitemap, the sk target of every other blog-hub rule)

# Blog hubs: EN /stories/ once stories/index.html exists, else /blog.html; SK likewise /sk/stories/ or /blog-sk.html.
RewriteRule ^ - [E=VB_HUB_EN:/blog.html,E=VB_HUB_SK:/blog-sk.html]
RewriteCond %{DOCUMENT_ROOT}/stories/index.html -f
RewriteRule ^ - [E=VB_HUB_EN:/stories/]
RewriteCond %{DOCUMENT_ROOT}/sk/stories/index.html -f
RewriteRule ^ - [E=VB_HUB_SK:/sk/stories/]

# Old reader URLs article.html?slug=S[&lang=xx] and /xx/article.html?slug=S → static story.
# RU slugs are Cyrillic, sent once- or twice-encoded (%d0… / %25d0…): explicit per post.
RewriteCond %{QUERY_STRING} (?:^|&)slug=%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?b8-%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?b5-%(?:25)?d0%(?:25)?bf%(?:25)?d0%(?:25)?b5%(?:25)?d1%(?:25)?80%(?:25)?d0%(?:25)?b5%(?:25)?d1%(?:25)?81%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?bd%(?:25)?d1%(?:25)?83%(?:25)?d1%(?:25)?82-%(?:25)?d0%(?:25)?bf%(?:25)?d0%(?:25)?b5%(?:25)?d1%(?:25)?87%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?82%(?:25)?d1%(?:25)?8c-%(?:25)?d0%(?:25)?b4%(?:25)?d0%(?:25)?b5%(?:25)?d0%(?:25)?bd%(?:25)?d1%(?:25)?8c%(?:25)?d0%(?:25)?b3%(?:25)?d0%(?:25)?b8-%(?:25)?d0%(?:25)?bf(?:&|$) [NC]
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/ru/stories/15058/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=%(?:25)?d1%(?:25)?85%(?:25)?d0%(?:25)?b2%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?b8%(?:25)?d1%(?:25)?82-%(?:25)?d0%(?:25)?b3%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?b4%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?82%(?:25)?d1%(?:25)?8c-%(?:25)?d1%(?:25)?81%(?:25)?d0%(?:25)?be-%(?:25)?d1%(?:25)?81%(?:25)?d0%(?:25)?b2%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?bc-%(?:25)?d0%(?:25)?b1%(?:25)?d0%(?:25)?b8%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?ba%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?bc-%(?:25)?d0%(?:25)?b2%(?:25)?d0%(?:25)?be%(?:25)?d1%(?:25)?82-%(?:25)?d0%(?:25)?b5(?:&|$) [NC]
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/ru/stories/15056/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=%(?:25)?d0%(?:25)?bf%(?:25)?d0%(?:25)?be%(?:25)?d1%(?:25)?87%(?:25)?d0%(?:25)?b5%(?:25)?d0%(?:25)?bc%(?:25)?d1%(?:25)?83-%(?:25)?d0%(?:25)?bf%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?bc%(?:25)?d0%(?:25)?bf-%(?:25)?d0%(?:25)?bc%(?:25)?d0%(?:25)?be%(?:25)?d1%(?:25)?83-%(?:25)?d0%(?:25)?b8-%(?:25)?d1%(?:25)?81%(?:25)?d1%(?:25)?8d%(?:25)?d0%(?:25)?b9%(?:25)?d0%(?:25)?bb%(?:25)?d0%(?:25)?be%(?:25)?d1%(?:25)?80-%(?:25)?d0%(?:25)?b4%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?8e%(?:25)?d1%(?:25)?82-%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?ba%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?b5-%(?:25)?d1%(?:25)?80%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?b7(?:&|$) [NC]
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/ru/stories/15054/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=39-%(?:25)?d1%(?:25)?82%(?:25)?d1%(?:25)?80%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?bb%(?:25)?d0%(?:25)?bb%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b2-%(?:25)?d0%(?:25)?b8-%(?:25)?d0%(?:25)?bf%(?:25)?d1%(?:25)?80%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b4%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?bb%(?:25)?d0%(?:25)?b6%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?b5%(?:25)?d1%(?:25)?82-%(?:25)?d1%(?:25)?80%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?81%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?b8-%(?:25)?d0%(?:25)?bf%(?:25)?d0%(?:25)?be%(?:25)?d1%(?:25)?87%(?:25)?d0%(?:25)?b5%(?:25)?d0%(?:25)?bc(?:&|$) [NC]
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/ru/stories/15052/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=%(?:25)?d1%(?:25)?80%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?bc-%(?:25)?d0%(?:25)?b2%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?ba%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?b7%(?:25)?d0%(?:25)?bc-%(?:25)?d0%(?:25)?b8-%(?:25)?d0%(?:25)?bf%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b4%(?:25)?d1%(?:25)?8a%(?:25)?d1%(?:25)?91%(?:25)?d0%(?:25)?bc-%(?:25)?d0%(?:25)?b1%(?:25)?d0%(?:25)?b8%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?ba%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?bd-%(?:25)?d1%(?:25)?81%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?b4%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?80%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?b0(?:&|$) [NC]
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/ru/stories/15048/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=%(?:25)?d0%(?:25)?b2%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b9%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?b0-%(?:25)?d0%(?:25)?b7%(?:25)?d0%(?:25)?b0-%(?:25)?d0%(?:25)?b1%(?:25)?d0%(?:25)?b8%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?ba%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?bd-jpmorgan-%(?:25)?d0%(?:25)?b8-jane-street-%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?ba%(?:25)?d1%(?:25)?83%(?:25)?d1%(?:25)?8e%(?:25)?d1%(?:25)?82-%(?:25)?d1%(?:25)?87%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?81%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?bd%(?:25)?d1%(?:25)?8b(?:&|$) [NC]
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/ru/stories/15043/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=%(?:25)?d0%(?:25)?b1%(?:25)?d0%(?:25)?b8%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?ba%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?bd-%(?:25)?d1%(?:25)?88%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?ba-blackrock-ibit-%(?:25)?d1%(?:25)?81%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?bb-%(?:25)?d0%(?:25)?b3%(?:25)?d0%(?:25)?bb%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?b2%(?:25)?d0%(?:25)?bd%(?:25)?d1%(?:25)?8b%(?:25)?d0%(?:25)?bc-%(?:25)?d0%(?:25)?b8%(?:25)?d1%(?:25)?81%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?be%(?:25)?d1%(?:25)?87%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?ba%(?:25)?d0%(?:25)?be(?:&|$) [NC]
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/ru/stories/15038/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=%(?:25)?d0%(?:25)?b2%(?:25)?d1%(?:25)?8b-%(?:25)?d1%(?:25)?83%(?:25)?d0%(?:25)?b7%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?b5%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?b5-%(?:25)?d0%(?:25)?bf%(?:25)?d0%(?:25)?be%(?:25)?d1%(?:25)?87%(?:25)?d0%(?:25)?b5%(?:25)?d0%(?:25)?bc%(?:25)?d1%(?:25)?83-%(?:25)?d0%(?:25)?b1%(?:25)?d0%(?:25)?b8%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?ba%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?bd-%(?:25)?d0%(?:25)?bf%(?:25)?d0%(?:25)?be%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?b5%(?:25)?d1%(?:25)?80%(?:25)?d1%(?:25)?8f%(?:25)?d0%(?:25)?bb-80-000-%(?:25)?d0%(?:25)?b8(?:&|$) [NC]
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/ru/stories/15034/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=%(?:25)?d0%(?:25)?b1%(?:25)?d0%(?:25)?b8%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?ba%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?bd-%(?:25)?d1%(?:25)?81%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b2%(?:25)?d0%(?:25)?b0-%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?bf%(?:25)?d1%(?:25)?83%(?:25)?d1%(?:25)?81%(?:25)?d0%(?:25)?ba%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?b5%(?:25)?d1%(?:25)?82%(?:25)?d1%(?:25)?81%(?:25)?d1%(?:25)?8f-%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?b6%(?:25)?d0%(?:25)?b5-80-000-%(?:25)?d0%(?:25)?b2-%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b6%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?b4(?:&|$) [NC]
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/ru/stories/15066/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=%(?:25)?d0%(?:25)?b7%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?bb%(?:25)?d0%(?:25)?be%(?:25)?d1%(?:25)?82%(?:25)?d0%(?:25)?be-%(?:25)?d0%(?:25)?ba%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?ba-%(?:25)?d0%(?:25)?bf%(?:25)?d0%(?:25)?be%(?:25)?d0%(?:25)?b6%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?80%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?8f-%(?:25)?d1%(?:25)?81%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?b3%(?:25)?d0%(?:25)?bd%(?:25)?d0%(?:25)?b0%(?:25)?d0%(?:25)?bb%(?:25)?d0%(?:25)?b8%(?:25)?d0%(?:25)?b7%(?:25)?d0%(?:25)?b0%(?:25)?d1%(?:25)?86%(?:25)?d0%(?:25)?b8%(?:25)?d1%(?:25)?8f-%(?:25)?d0%(?:25)?b1%(?:25)?d0%(?:25)?b8%(?:25)?d1%(?:25)?82(?:&|$) [NC]
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/ru/stories/15064/? [R=301,L]
# Language from the path prefix, else from &lang=; ASCII slug.
RewriteRule ^(?:(de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ - [E=VB_AL:$1]
RewriteCond %{ENV:VB_AL} ^$
RewriteCond %{QUERY_STRING} (?:^|&)lang=([a-z]{2})(?:&|$)
RewriteRule ^article\.html$ - [E=VB_AL:%1]
RewriteCond %{QUERY_STRING} (?:^|&)slug=([A-Za-z0-9-]+)(?:&|$)
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ - [E=VB_SLUG:%1]
# 1. same-language story, 2. EN story, 3. SK story
RewriteCond %{ENV:VB_SLUG} .
RewriteCond %{ENV:VB_AL} .
RewriteCond %{DOCUMENT_ROOT}/%{ENV:VB_AL}/stories/%{ENV:VB_SLUG}/index.html -f
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/%{ENV:VB_AL}/stories/%{ENV:VB_SLUG}/? [R=301,L]
RewriteCond %{ENV:VB_SLUG} .
RewriteCond %{DOCUMENT_ROOT}/stories/%{ENV:VB_SLUG}/index.html -f
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/stories/%{ENV:VB_SLUG}/? [R=301,L]
RewriteCond %{ENV:VB_SLUG} .
RewriteCond %{DOCUMENT_ROOT}/sk/stories/%{ENV:VB_SLUG}/index.html -f
RewriteRule ^(?:(?:de|es|fr|pl|hu|cs|sk|uk|ru|it)/)?article\.html$ https://virtuse.com/sk/stories/%{ENV:VB_SLUG}/? [R=301,L]
# 4. /xx/article.html (no such file) without a story → that language's blog hub.
#    The root /article.html reader stays for slugs without a story page (posts newer
#    than the last stories build, and the /a/<slug> 302 fallback above).
RewriteRule ^de/article\.html$ https://virtuse.com/de/blog.html? [R=301,L]
RewriteRule ^es/article\.html$ https://virtuse.com/es/blog.html? [R=301,L]
RewriteRule ^fr/article\.html$ https://virtuse.com/fr/blog.html? [R=301,L]
RewriteRule ^pl/article\.html$ https://virtuse.com/pl/blog.html? [R=301,L]
RewriteRule ^hu/article\.html$ https://virtuse.com/hu/blog.html? [R=301,L]
RewriteRule ^cs/article\.html$ https://virtuse.com/cs/blog.html? [R=301,L]
RewriteRule ^sk/article\.html$ https://virtuse.com%{ENV:VB_HUB_SK}? [R=301,L]
RewriteRule ^uk/article\.html$ https://virtuse.com/uk/blog.html? [R=301,L]
RewriteRule ^ru/article\.html$ https://virtuse.com/ru/blog.html? [R=301,L]
RewriteRule ^it/article\.html$ https://virtuse.com%{ENV:VB_HUB_EN}? [R=301,L]

# The table (all languages: /xx/<old>/ → /xx/<target> if it exists, else EN)
RewriteRule ^(?:gold(?:/.*)?|silver(?:/.*)?|platinum(?:/.*)?|commodities(?:/.*)?|crypto-commodities-what-are-they(?:/.*)?|pax-gold-prospectus(?:/.*)?|etfs(?:/.*)?|oil(?:/.*)?|crude-oil(?:/.*)?)$ https://virtuse.com/asset-returns.html [R=301,L]
RewriteRule ^de/(?:gold(?:/.*)?|silver(?:/.*)?|platinum(?:/.*)?|commodities(?:/.*)?|crypto-commodities-what-are-they(?:/.*)?|pax-gold-prospectus(?:/.*)?|etfs(?:/.*)?|oil(?:/.*)?|crude-oil(?:/.*)?)$ https://virtuse.com/de/asset-returns.html [R=301,L]
