# END legacy-exchange

# Unknown paths: the site's own 404 page with status 404 (no more forward to blog.virtuse.com).
# 410 Gone (legacy-exchange) shows the same page with status 410. Language folders use their own copy.
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html
<If "%{REQUEST_URI} =~ m#^/de/#">
  ErrorDocument 404 /de/404.html
  ErrorDocument 410 /de/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/es/#">
  ErrorDocument 404 /es/404.html
  ErrorDocument 410 /es/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/fr/#">
  ErrorDocument 404 /fr/404.html
  ErrorDocument 410 /fr/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/pl/#">
  ErrorDocument 404 /pl/404.html
  ErrorDocument 410 /pl/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/hu/#">
  ErrorDocument 404 /hu/404.html
  ErrorDocument 410 /hu/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/cs/#">
  ErrorDocument 404 /cs/404.html
  ErrorDocument 410 /cs/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/sk/#">
  ErrorDocument 404 /sk/404.html
  ErrorDocument 410 /sk/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/uk/#">
  ErrorDocument 404 /uk/404.html
  ErrorDocument 410 /uk/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/ru/#">
  ErrorDocument 404 /ru/404.html
  ErrorDocument 410 /ru/404.html
</If>

# Security headers for virtuse.com
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Browser caching (2026-10-08, Lighthouse "Use efficient cache lifetimes"). Before this
# no Cache-Control was sent, so browsers guessed lifetimes from Last-Modified (an old
# page could be served from cache for days without asking). Files keep their names
# when they change, so lifetimes stay short except for the hashed module files.
<IfModule mod_headers.c>
  # Pages and data: always revalidate (cheap 304 when unchanged).
  Header set Cache-Control "no-cache" "expr=%{CONTENT_TYPE} =~ m#^(text/html|application/json)#"
  # Unversioned CSS/JS (styles.css, cookie-consent.js, ...): 1 hour.
  Header set Cache-Control "public, max-age=3600" "expr=%{CONTENT_TYPE} =~ m#^(text/css|application/javascript|text/javascript)#"
  # Images and fonts: 7 days (some images are replaced under the same name).
  Header set Cache-Control "public, max-age=604800" "expr=%{CONTENT_TYPE} =~ m#^(image/|font/|application/font)#"
  # Layer 2 module bundles have a content hash in the name: 1 year.
  Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/concierge-assets/#"
</IfModule>
