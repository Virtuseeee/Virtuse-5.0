RewriteRule ^fr/(?:virtusex-platform(?:/.*)?|token-listing(?:/.*)?|virtu-token(?:/.*)?|delisting-announcement(?:/.*)?|hummingbot-integration(?:/.*)?)$ https://virtuse.com/fr/concierge.html [R=301,L]
